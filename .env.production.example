# ─── Copiez ce fichier en .env sur le serveur de production et complétez-le ───
# cp .env.production.example .env

# ─── Domaine & HTTPS (Caddy) ──────────────────────────────────────────────────
# Le domaine DOIT déjà pointer (enregistrement DNS A/AAAA) vers l'IP de ce serveur
# avant de démarrer Caddy, sinon la validation Let's Encrypt échouera.
DOMAIN=edt.mon-domaine.fr
# Email utilisé par Let's Encrypt pour les notifications d'expiration de certificat.
ACME_EMAIL=admin@mon-domaine.fr
FRONTEND_URL=https://edt.mon-domaine.fr

# ─── Base de données ───────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_NAME=edt
DB_USER=edt_user
# Générez des mots de passe forts, par ex. : openssl rand -base64 32
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# ─── Clés d'accès de l'application ─────────────────────────────────────────────
# Générez des clés fortes, par ex. : openssl rand -hex 32
ADMIN_KEY=change-me-admin-key
VS_KEY=change-me-vie-scolaire-key

# ─── Envoi d'emails (SMTP réel — pas de Mailpit en production) ─────────────────
SMTP_HOST=smtp.votre-fournisseur.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-utilisateur-smtp
SMTP_PASSWORD=votre-mot-de-passe-smtp
SMTP_FROM=EDT Individualisation <no-reply@mon-domaine.fr>

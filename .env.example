# Envoi d'emails (bouton "Envoyer l'EDT par mail")
# Par défaut : Mailpit, un faux serveur SMTP fourni par docker-compose qui capture les emails
# sans les envoyer réellement. Consultez-les sur http://localhost:8025.
# Pour un envoi réel, remplacez ces valeurs par celles de votre fournisseur SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EDT Individualisation <no-reply@roville.fr>
